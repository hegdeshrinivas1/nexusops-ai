# ==============================================================================
# Oracle Agentic AI Configuration
# ==============================================================================

# Model Provider: "openai", "groq", "oci", or "mock" (offline fallback)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq (optional high-speed alternative)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Oracle Cloud Infrastructure (OCI) GenAI (optional)
# LLM_PROVIDER=oci
# OCI_CONFIG_PROFILE=DEFAULT
# OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaa...
# OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com

# Oracle Database 23ai AI Vector Search (optional enterprise backend)
# ORACLE_23AI_ENABLED=true
# ORACLE_USER=admin
# ORACLE_PASSWORD=your_password
# ORACLE_DSN=localhost:1521/FREEPDB1
